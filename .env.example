DATABASE_URL=postgres://user:password@host/db
INGEST_SECRET=generate-32-byte-hex
# LLM provider, free-first: set GOOGLE key (aistudio.google.com, free tier, no card)
# OR the Vercel AI Gateway key (paid). Google wins when both are set.
GOOGLE_GENERATIVE_AI_API_KEY=
# LLM auto-falls-back gemini-3.5-flash -> gemini-3.1-flash-lite when the primary
# is overloaded (503) or rate-limited (429). Set LLM_GEMINI_MODEL to PIN a single
# model and skip the fallback chain (e.g. force the stabler lite model for a bulk job).
LLM_GEMINI_MODEL=
AI_GATEWAY_API_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Imprint operator data — kept out of the public repo on purpose (see imprint page)
NEXT_PUBLIC_IMPRINT_NAME=
NEXT_PUBLIC_IMPRINT_STREET=
NEXT_PUBLIC_IMPRINT_CITY=
NEXT_PUBLIC_IMPRINT_EMAIL=
# Donation banner (handles, not URLs) — banner stays hidden while both are empty
NEXT_PUBLIC_DONATE_KOFI=
NEXT_PUBLIC_DONATE_GITHUB=
# Local Ollama as last-resort classifier fallback (local runs only; unset in prod)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# OpenSky Network (free account) — real historical jet flights for CO2 backfill
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# AISStream.io (free) — real-time yacht AIS for forward CO2 tracking
AISSTREAM_API_KEY=
