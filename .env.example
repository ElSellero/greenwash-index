DATABASE_URL=postgres://user:password@host/db
INGEST_SECRET=generate-32-byte-hex
# LLM provider, free-first: set GOOGLE key (aistudio.google.com, free tier, no card)
# OR the Vercel AI Gateway key (paid). Google wins when both are set.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Imprint operator data — kept out of the public repo on purpose (see imprint page)
NEXT_PUBLIC_IMPRINT_NAME=
NEXT_PUBLIC_IMPRINT_STREET=
NEXT_PUBLIC_IMPRINT_CITY=
NEXT_PUBLIC_IMPRINT_EMAIL=
